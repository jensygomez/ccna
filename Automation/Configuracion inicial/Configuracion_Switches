enable
configure terminal

! ---- Hostname y Dominio ----
hostname Switch-01
ip domain-name gns3.lab

! ---- Contraseña Enable ----
enable secret cisco112

! ---- Configuración de Consola ----
line console 0
 password cisco112
 login
 logging synchronous
 exec-timeout 5 0
 exit

! ---- Usuarios ----
username cisco112 privilege 15 secret cisco112
username user privilege 1 secret user

! ---- SSH ----
crypto key generate rsa modulus 2048
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 2

! ---- VLAN de Administración ----
vlan 99
 name Management
exit
interface Vlan99
 description Management VLAN
 ip address 192.168.0.112 255.255.255.0
 no shutdown
exit

! ---- Configuración de Puertos ----
interface GigabitEthernet3/3
 description Hacia Router o Switch superior
 switchport mode access
 switchport access vlan 99
 no shutdown

! ---- Apagar interfaces no utilizadas ----
interface range GigabitEthernet0/0-3, GigabitEthernet1/0-3, GigabitEthernet2/0-3, GigabitEthernet3/0-2
 shutdown


! ---- Gateway por defecto ----
ip default-gateway 192.168.0.1

! ---- DNS ----
ip domain-lookup
ip name-server 8.8.8.8
ip name-server 8.8.4.4

! ---- ACL de Protección ----
ip access-list standard PROTECT-VTY
 permit 192.168.0.0 0.0.0.255
 permit 192.168.1.0 0.0.0.255
 permit 192.168.18.0 0.0.0.255
 deny any log

! ---- Seguridad VTY ----
line vty 0 15
 login local
 transport input ssh telnet
 exec-timeout 10 0
 access-class PROTECT-VTY in
 exit

! ---- Logging ----
logging buffered 8192 debugging

! ---- Servicios Innecesarios ----
no ip http server
no ip http secure-server

! ---- Timestamps ----
service timestamps debug datetime msec localtime show-timezone
service timestamps log datetime msec localtime show-timezone

! ---- Guardar Configuración ----
end
write memory